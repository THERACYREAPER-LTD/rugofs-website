# Copy this file to .env for local development (.env is gitignored — never commit real keys).
# In production, set these in Netlify: Site settings → Environment variables.

# Sanity project/dataset — not secrets (visible in every Studio network
# request), but set here so this project can point at a different
# project/dataset without a code change. src/lib/sanity.ts has a hardcoded
# fallback to the real values if these are unset, so the site still builds
# without this block — but set it in Netlify for clarity/future-proofing.
PUBLIC_SANITY_PROJECT_ID=57yv9ur6
PUBLIC_SANITY_DATASET=production

# Client-safe — Astro only exposes PUBLIC_-prefixed vars to the browser.
PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SERVER-ONLY — never prefix this with PUBLIC_. Used only in
# src/pages/order-confirmed.astro (a server-rendered route) to verify
# payments with Paystack. Never commit a real value for this.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
