# Copy this file to .env for local development (.env is gitignored — never commit real keys).
# In production, set these in Netlify: Site settings → Environment variables.

# Sanity project/dataset — not secrets (visible in every Studio network
# request), but set here so this project can point at a different
# project/dataset without a code change. src/lib/sanity.ts has a hardcoded
# fallback to the real values if these are unset, so the site still builds
# without this block — but set it in Netlify for clarity/future-proofing.
PUBLIC_SANITY_PROJECT_ID=57yv9ur6
PUBLIC_SANITY_DATASET=production

# Client-safe — Astro only exposes PUBLIC_-prefixed vars to the browser.
PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SERVER-ONLY — never prefix this with PUBLIC_. Used only in
# src/pages/order-confirmed.astro (a server-rendered route) to verify
# payments with Paystack. Never commit a real value for this.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — stores order records (cart contents, customer/delivery info,
# status) written after a payment verifies, and read back on the order
# status lookup page. The project already exists: dajzidimozwaujnzebqq
# (https://supabase.com/dashboard/project/dajzidimozwaujnzebqq).
#
# URL is not a secret — client-safe.
PUBLIC_SUPABASE_URL=https://dajzidimozwaujnzebqq.supabase.co

# SERVER-ONLY — the service_role key, NOT the anon/publishable key. This
# bypasses Row Level Security, which is exactly what's needed since the
# `orders` table has RLS enabled with no policies (nothing is reachable via
# the anon key at all, by design). Get this from the Supabase dashboard:
# Project Settings → API → service_role key (click "Reveal"). Never commit
# a real value for this, and never prefix it with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRhanppZGltb3p3YXVqbnplYnFxIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTQyODg0NSwiZXhwIjoyMTAxMDA0ODQ1fQ.F9eanjzrFhRTmhyoagtNBTGhwA0CesDRa4Jzon1652c

# Analytics / ad pixels — all optional and independent (see
# src/lib/tracking.ts and src/components/Analytics.astro). None of these
# are secrets — measurement/pixel/partner IDs are meant to be visible in
# page source — but they're still PUBLIC_-prefixed for consistency and
# because that's what makes them available in client-side code at all.
# Leave any of these unset to skip that platform entirely; no code change
# needed later, just add the value in Netlify and redeploy.

# Google Analytics 4 — Admin → Data Streams → your web stream → Measurement ID.
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads — Tools & Settings → Conversions → your conversion action →
# "Tag setup" → look for the ID starting with AW-. Also covers YouTube ad
# conversions — YouTube ads run through Google Ads, there's no separate
# YouTube pixel.
PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# Optional — the "/AbC-D_efG-..." portion of a specific conversion
# action's tag snippet, if you want granular per-action conversion
# tracking rather than just page-level remarketing.
PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=AW-XXXXXXXXX/AbC-D_efG-h1234567

# Meta (Facebook/Instagram) Pixel — Events Manager → Data Sources → your
# pixel → Settings, or the number in the base pixel code snippet.
PUBLIC_META_PIXEL_ID=000000000000000

# TikTok Pixel — Assets → Events → Web Events → your pixel → Pixel ID.
PUBLIC_TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXXXXXXXXXXX

# Pinterest Tag — Ads → Conversion → your tag → Tag ID.
PUBLIC_PINTEREST_TAG_ID=0000000000000

# LinkedIn Insight Tag — Campaign Manager → Account Assets → Insight Tag →
# Partner ID (just the number, not the full script).
PUBLIC_LINKEDIN_PARTNER_ID=0000000

# Google Search Console — Settings → Ownership verification → HTML tag
# method → the value of the content="..." attribute (not the whole tag).
PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
