---
import { whatsappLink } from "../data/siteSettings";
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/images/brand/rugofs-logo.png" alt="Rugofs Foods" class="brand-logo" />
      <span class="brand-name">RUGOFS FOODS</span>
    </a>

    <div class="header-controls">
      <a href="/cart" class="nav-cart" aria-label="View cart">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span class="nav-cart-count" data-cart-count hidden>0</span>
      </a>
      <button
        type="button"
        class="nav-toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
      >
        <svg class="icon-menu" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" hidden aria-hidden="true">
          <line x1="5" y1="5" x2="19" y2="19"/>
          <line x1="19" y1="5" x2="5" y2="19"/>
        </svg>
      </button>
    </div>

    <nav class="site-nav" id="site-nav" data-site-nav>
      <a href="/">Home</a>
      <a href="/products">Shop</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/products" class="btn btn-primary nav-shop">Shop Now</a>
      <a
        class="btn btn-whatsapp-outline nav-whatsapp"
        href={whatsappLink("Hi Rugofs Foods, I have a question.")}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat with Rugofs Foods on WhatsApp"
        title="Chat with us on WhatsApp"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.29-.15-1.7-.84-1.96-.93-.26-.1-.46-.15-.65.14-.19.29-.75.93-.92 1.12-.17.19-.34.22-.63.07-.29-.15-1.22-.45-2.32-1.43-.86-.76-1.44-1.71-1.6-2-.17-.29-.02-.44.13-.59.13-.13.29-.34.44-.51.15-.17.19-.29.29-.48.1-.19.05-.36-.02-.51-.07-.15-.65-1.58-.9-2.16-.24-.58-.48-.5-.65-.51h-.56c-.19 0-.51.07-.78.36s-1.02 1-1.02 2.44 1.05 2.83 1.2 3.03c.15.19 2.06 3.15 5 4.42.7.3 1.24.48 1.67.61.7.22 1.34.19 1.84.12.56-.08 1.7-.7 1.94-1.37.24-.68.24-1.26.17-1.38-.07-.12-.26-.19-.55-.34z"/><path d="M12.02 2C6.5 2 2 6.48 2 12c0 1.85.5 3.58 1.36 5.07L2 22l5.06-1.32A9.94 9.94 0 0 0 12.02 22C17.53 22 22 17.52 22 12S17.53 2 12.02 2zm0 18.14c-1.68 0-3.24-.48-4.56-1.32l-.33-.2-3 .78.8-2.93-.21-.3A8.11 8.11 0 0 1 3.86 12c0-4.5 3.66-8.15 8.16-8.15S20.16 7.5 20.16 12s-3.66 8.14-8.14 8.14z"/></svg>
        <span>WhatsApp</span>
      </a>
    </nav>
  </div>
</header>

<script>
  import { cartCount, getCart, CART_EVENT_NAME } from "../lib/cart";

  function updateBadge() {
    const badges = document.querySelectorAll<HTMLElement>("[data-cart-count]");
    const count = cartCount(getCart());
    badges.forEach((badge) => {
      badge.textContent = String(count);
      badge.hidden = count === 0;
    });
  }

  updateBadge();
  window.addEventListener(CART_EVENT_NAME, updateBadge);
  // Cart can also change in another tab; storage event catches that.
  window.addEventListener("storage", updateBadge);

  // Mobile nav toggle — the nav panel is collapsed by default below the
  // .header-inner wrap breakpoint (see CSS) and expands as a dropdown when
  // the hamburger button is pressed. Above that breakpoint the toggle is
  // hidden entirely and the nav renders as the normal horizontal bar.
  const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const siteNav = document.querySelector<HTMLElement>("[data-site-nav]");
  const iconMenu = navToggle?.querySelector<HTMLElement>(".icon-menu");
  const iconClose = navToggle?.querySelector<HTMLElement>(".icon-close");

  function setNavOpen(open: boolean) {
    siteNav?.classList.toggle("is-open", open);
    navToggle?.setAttribute("aria-expanded", String(open));
    navToggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (iconMenu) iconMenu.hidden = open;
    if (iconClose) iconClose.hidden = !open;
  }

  navToggle?.addEventListener("click", () => {
    setNavOpen(!siteNav?.classList.contains("is-open"));
  });

  // Closing on link click keeps the panel from staying open after
  // navigating to a new page (relevant on same-page hash links / SPA-ish
  // browser back-forward cache restores).
  siteNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setNavOpen(false));
  });

  // If the viewport is resized past the mobile breakpoint while the panel
  // is open (e.g. rotating a tablet, or a desktop dev-tools resize), reset
  // it rather than leaving a stuck-open dropdown behind.
  window.addEventListener("resize", () => {
    if (window.innerWidth > 860) setNavOpen(false);
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-logo {
    height: 46px;
    width: 46px;
    object-fit: contain;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-plum);
    letter-spacing: 0.02em;
    font-size: 1.05rem;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    order: 3;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-plum);
    cursor: pointer;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
    order: 2;
  }

  .site-nav a:not(.btn) {
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .site-nav a:not(.btn):hover {
    color: var(--color-plum);
  }

  .nav-shop {
    padding: 0.55em 1.2em;
    font-size: 0.85rem;
  }

  .nav-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.5em 1em;
    font-size: 0.85rem;
  }

  .nav-cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-plum);
  }

  .nav-cart:hover {
    color: var(--color-gold-text);
  }

  .nav-cart-count {
    position: absolute;
    top: 0.1em;
    right: 0.35em;
    min-width: 1.15em;
    height: 1.15em;
    padding: 0 0.3em;
    border-radius: 999px;
    background: var(--color-gold);
    color: #3A2A05;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.68rem;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* Below this width, the horizontal nav bar becomes a collapsible dropdown
     panel triggered by the hamburger button — matches the breakpoint
     already used for .hero-inner elsewhere on the site. */
  @media (max-width: 860px) {
    /* Brand + controls need to hold one row on narrow phones — at 375px
       they were tipping into a wrap by ~1px (328px needed vs 327px
       available), and by more on a 320px screen. Trimming the gap and
       logo/wordmark size here buys back that margin. */
    .header-inner {
      gap: 0.5rem;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .brand {
      gap: 0.4rem;
    }

    .brand-logo {
      height: 34px;
      width: 34px;
    }

    .brand-name {
      font-size: 0.8rem;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      order: 4;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-border);
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav a:not(.btn) {
      padding: 0.85em 0.2em;
      font-size: 1rem;
      border-bottom: 1px solid var(--color-border);
    }

    .nav-shop,
    .nav-whatsapp {
      width: 100%;
      justify-content: center;
      margin-top: 0.75rem;
      font-size: 0.95rem;
      padding: 0.75em 1.2em;
    }
  }
</style>
