---
import { siteSettings, whatsappLink } from "../data/siteSettings";
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/images/rugofs-logo-placeholder.svg" alt="Rugofs Foods" class="brand-logo" />
      <span class="brand-name">RUGOFS FOODS</span>
    </a>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/products">Shop</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a
        class="btn btn-whatsapp nav-whatsapp"
        href={whatsappLink("Hi Rugofs Foods, I'd like to place an order.")}
        target="_blank"
        rel="noopener noreferrer"
      >
        Order via WhatsApp
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-logo {
    height: 42px;
    width: 42px;
    object-fit: cover;
    border-radius: 6px;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-plum);
    letter-spacing: 0.02em;
    font-size: 1.05rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
  }

  .site-nav a:not(.btn) {
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .site-nav a:not(.btn):hover {
    color: var(--color-plum);
  }

  .nav-whatsapp {
    padding: 0.55em 1.1em;
    font-size: 0.85rem;
  }
</style>
