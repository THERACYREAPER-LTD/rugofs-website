---
import type { Product, PackSize } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const approvedSizes = product.packSizes.filter((p: PackSize) => p.nafdacApproved);
const sizeLabel = approvedSizes.map((s: PackSize) => s.size).join(", ");
---

<a href={`/products/${product.slug}`} class="card product-card">
  {product.images.length > 0 ? (
    <img src={product.images[0]} alt={product.name} class="product-photo" />
  ) : (
    <div class="placeholder-photo">Product photo coming soon</div>
  )}
  <div class="card-body">
    {product.isBestseller && <span class="badge">Best Seller</span>}
    <h3 class="product-name">{product.name}</h3>
    <p class="product-desc">{product.shortDescription}</p>
    <p class="product-size">{sizeLabel}</p>
  </div>
</a>

<style>
  .product-card {
    color: var(--color-text);
  }

  .product-card:hover {
    text-decoration: none;
    border-color: var(--color-gold);
  }

  .product-photo {
    aspect-ratio: 4 / 3;
    object-fit: contain;
    width: 100%;
    padding: 1.5rem;
    background: radial-gradient(ellipse at center, rgba(200, 155, 60, 0.12) 0%, rgba(245, 239, 227, 0.55) 45%, transparent 72%);
    filter: drop-shadow(0 14px 18px rgba(43, 35, 32, 0.16));
    transition: filter 0.18s ease, transform 0.18s ease;
  }

  .product-card:hover .product-photo {
    filter: drop-shadow(0 18px 24px rgba(43, 35, 32, 0.22));
    transform: translateY(-2px);
  }

  .product-name {
    font-size: 1.1rem;
    margin-bottom: 0;
  }

  .product-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .product-size {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--color-brown);
    margin-bottom: 0;
  }
</style>
