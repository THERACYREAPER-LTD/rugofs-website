---
// GTM's head snippet. The matching <noscript> body snippet lives in
// BaseLayout.astro right after the opening <body> tag — that's GTM's
// standard two-part install, not something that can be combined into one
// component since it needs to be split across <head> and <body>.
import { GTM_CONTAINER_ID, GOOGLE_SITE_VERIFICATION } from "../lib/tracking";
---

{GOOGLE_SITE_VERIFICATION && (
  <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
)}

{GTM_CONTAINER_ID && (
  <script define:vars={{ GTM_CONTAINER_ID }}>
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var f = d.getElementsByTagName(s)[0],
        j = d.createElement(s),
        dl = l != "dataLayer" ? "&l=" + l : "";
      j.async = true;
      j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, "script", "dataLayer", GTM_CONTAINER_ID);
  </script>
)}
