---
import { siteSettings } from "../data/siteSettings";

// Simplified outline glyphs matching the site's existing icon style (see
// the WhatsApp icon in Header.astro) — kept inline rather than pulling in
// an icon-font/library dependency for five icons. Keyed by lowercased
// platform name as entered in Sanity's socialLinks field.
const SOCIAL_ICONS: Record<string, string> = {
  instagram: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none"/></svg>`,
  youtube: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l6 3-6 3z" fill="currentColor" stroke="none"/></svg>`,
  facebook: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.9.3-1.5 1.6-1.5h1.4V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10.5H8v3h2.3V21h3.2z"/></svg>`,
  linkedin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8.3" r="0.9" fill="currentColor" stroke="none"/><path d="M7.3 11v6.3M7.3 13.2v4.1M11 11v6.3M11 13.8c0-1.6 1-2.6 2.4-2.6 1.5 0 2.4 1 2.4 2.6v3.5" /></svg>`,
  pinterest: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 19c.5-2 1.5-6.5 1.5-6.5m0 0c-.4-.8-.6-2.4.3-3.5.9-1.1 2.6-.9 3.1.3.5 1.2-.2 3.2-.9 4.3-.6 1-.1 2.2 1 2.2 1.9 0 3.2-2.4 3.2-4.7 0-2-1.6-3.9-4.3-3.9-3.2 0-4.9 2.2-4.9 4.5 0 .8.3 1.7.8 2.2"/></svg>`,
};
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <div class="footer-brand">
        <img src="/images/brand/rugofs-logo.png" alt="Rugofs Foods" class="footer-logo" />
        <span>RUGOFS FOODS</span>
      </div>
      <p class="footer-tagline">{siteSettings.tagline}</p>
      {siteSettings.socialLinks.length > 0 && (
        <div class="footer-social">
          {siteSettings.socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Rugofs Foods on ${link.platform}`}
              class="footer-social-link"
              set:html={SOCIAL_ICONS[link.platform.toLowerCase()] ?? ""}
            />
          ))}
        </div>
      )}
    </div>
    <div class="footer-col">
      <h4>Contact</h4>
      <p>{siteSettings.address}</p>
      <p><a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a></p>
      {/* This number is WhatsApp-only — it can't receive voice calls, so it's
          never rendered as a tel: link anywhere on the site. The WhatsApp
          link below is the only click-to-contact affordance for it. */}
      <p>
        <a href={`https://wa.me/${siteSettings.whatsappNumber}`} target="_blank" rel="noopener noreferrer">
          Chat on WhatsApp: {siteSettings.phone}
        </a>
      </p>
    </div>
    <div class="footer-col">
      <h4>Shop</h4>
      <p><a href="/products">All Products</a></p>
      <p><a href="/cart">Your Cart</a></p>
      <p><a href="/order-status">Track Your Order</a></p>
      <p><a href="/about">Our Story</a></p>
      <p><a href="/contact">Contact Us</a></p>
    </div>
    <div class="footer-col">
      <h4>Policies</h4>
      <p><a href="/policies#delivery">Delivery</a></p>
      <p><a href="/policies#refunds">Refunds &amp; Returns</a></p>
      <p><a href="/policies#privacy">Privacy</a></p>
      <p><a href="/policies#terms">Terms of Service</a></p>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} Rugofs Foods. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-plum);
    color: var(--color-cream);
    margin-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2rem;
    padding: 3rem 1.5rem 2rem;
  }

  @media (max-width: 780px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.03em;
    margin-bottom: 0.75rem;
  }

  .footer-logo {
    height: 36px;
    width: 36px;
    object-fit: contain;
    background: var(--color-cream);
    border-radius: 50%;
    padding: 3px;
  }

  .footer-tagline {
    color: #E3D4E1;
    font-size: 0.9rem;
    max-width: 32ch;
  }

  .footer-social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(245, 239, 227, 0.35);
    color: var(--color-cream);
  }

  .footer-social-link:hover {
    text-decoration: none;
    border-color: var(--color-cream);
    color: var(--color-gold-on-dark);
  }

  .footer-social-link :global(svg) {
    width: 17px;
    height: 17px;
  }

  .footer-col h4 {
    font-family: var(--font-heading);
    color: var(--color-gold-on-dark);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .footer-col p {
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .footer-col a {
    color: var(--color-cream);
  }

  .footer-bottom {
    border-top: 1px solid rgba(245, 239, 227, 0.15);
    padding: 1rem 1.5rem;
    font-size: 0.8rem;
    color: #C9B9C7;
  }
</style>
