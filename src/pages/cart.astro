---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import { PAYSTACK_PUBLIC_KEY } from "../data/payment";
import { whatsappLink } from "../data/siteSettings";

const whatsappFallback = whatsappLink(
  "Hi Rugofs Foods, I'd like to order but I'm having trouble with the checkout on your site.",
);
---

<BaseLayout title="Your Cart" description="Review your Rugofs Foods order." noindex>
  <section class="section">
    <div class="container cart-page" data-paystack-key={PAYSTACK_PUBLIC_KEY}>
      <h1>Your Cart</h1>

      <div data-cart-empty class="cart-empty" hidden>
        <p>Your cart is empty.</p>
        <a href="/products" class="btn btn-primary">Browse Products</a>
      </div>

      <div data-cart-filled class="cart-filled" hidden>
        <div class="cart-grid">
          <div class="cart-items" data-cart-items></div>

          <div class="cart-summary">
            <div class="summary-row summary-subtotal">
              <span>Subtotal</span>
              <span data-cart-subtotal>₦0</span>
            </div>
            <div class="summary-row summary-delivery" data-delivery-fee-row hidden>
              <span>Delivery</span>
              <span data-delivery-fee-amount>₦0</span>
            </div>
            <div class="summary-row summary-total" data-summary-total-row hidden>
              <span>Total</span>
              <span data-summary-total>₦0</span>
            </div>
            <p class="summary-note" data-delivery-fallback-note>
              Delivery fee (if applicable) is confirmed with you directly after
              your order, based on your location — it's not charged here at
              checkout.
            </p>

            <p class="summary-note batch-summary-note" data-batch-summary-note hidden>
              We produce in batches once enough orders come in for a product — this keeps quality
              high and costs down. You'll see live batch progress on each item above, and we'll
              confirm expected timing after checkout.
            </p>

            <hr class="divider" />

            <form data-checkout-form class="checkout-form">
              <label>
                Full Name
                <input type="text" name="name" required autocomplete="name" />
              </label>
              <label>
                Email <span class="req-note">(required by Paystack for your receipt)</span>
                <input type="email" name="email" required autocomplete="email" />
              </label>
              <label>
                Phone / WhatsApp Number
                <input type="tel" name="phone" required autocomplete="tel" />
              </label>

              <fieldset class="delivery-fieldset">
                <legend>How would you like your order?</legend>
                <label class="radio-label">
                  <input type="radio" name="deliveryMethod" value="pickup" checked />
                  In-store pickup (no delivery fee)
                </label>
                <label class="radio-label">
                  <input type="radio" name="deliveryMethod" value="delivery" />
                  Delivery (fee confirmed after order)
                </label>
              </fieldset>

              <label data-delivery-address-field hidden>
                Delivery Address
                <textarea name="deliveryAddress" rows="2" placeholder="Street address / landmark"></textarea>
              </label>
              <div class="delivery-location-row" data-delivery-location-row hidden>
                <label>
                  City
                  <input type="text" name="deliveryCity" autocomplete="address-level2" />
                </label>
                <label>
                  State
                  <input type="text" name="deliveryState" autocomplete="address-level1" />
                </label>
              </div>
              <p class="delivery-quote-status" data-delivery-quote-status hidden></p>

              <button type="submit" class="btn btn-primary pay-btn">
                Pay Now — <span data-cart-subtotal-btn>₦0</span>
              </button>

              <p class="checkout-error" data-checkout-error hidden></p>
            </form>

            <p class="continue-shopping-note">
              <a href="/products">← Continue Shopping</a>
            </p>

            <p class="whatsapp-fallback-note">
              Having trouble checking out?{" "}
              <a href={whatsappFallback} target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a>{" "}
              and we'll help you complete your order.
            </p>

            <p class="checkout-policy-note">
              By ordering, you agree to our <a href="/policies#delivery">delivery</a> and
              <a href="/policies#refunds">refund</a> policies.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    getCart,
    cartSubtotalNGN,
    updateQuantity,
    removeFromCart,
    clearCart,
    CART_EVENT_NAME,
    type CartItem,
  } from "../lib/cart";
  import { cartMessage } from "../lib/batchProgress";
  import { trackInitiateCheckout } from "../lib/tracking";

  const emptyEl = document.querySelector<HTMLElement>("[data-cart-empty]");
  const filledEl = document.querySelector<HTMLElement>("[data-cart-filled]");
  const itemsEl = document.querySelector<HTMLElement>("[data-cart-items]");
  const subtotalEl = document.querySelector<HTMLElement>("[data-cart-subtotal]");
  const payBtnAmountEl = document.querySelector<HTMLElement>("[data-cart-subtotal-btn]");
  const deliveryFeeRow = document.querySelector<HTMLElement>("[data-delivery-fee-row]");
  const deliveryFeeAmountEl = document.querySelector<HTMLElement>("[data-delivery-fee-amount]");
  const summaryTotalRow = document.querySelector<HTMLElement>("[data-summary-total-row]");
  const summaryTotalEl = document.querySelector<HTMLElement>("[data-summary-total]");
  const deliveryFallbackNote = document.querySelector<HTMLElement>("[data-delivery-fallback-note]");
  const deliveryQuoteStatusEl = document.querySelector<HTMLElement>("[data-delivery-quote-status]");
  const deliveryLocationRow = document.querySelector<HTMLElement>("[data-delivery-location-row]");
  const pageEl = document.querySelector<HTMLElement>(".cart-page");
  const publicKey = pageEl?.dataset.paystackKey ?? "";

  // Live Topship quote for the currently-entered delivery city, if any —
  // null whenever pickup is selected, the city hasn't been quoted yet, or
  // Topship isn't configured (delivery-quote.ts returns available:false in
  // all of those cases, and this just falls back to the pre-Topship
  // behavior of confirming the fee after checkout instead of blocking it).
  let currentQuote: { feeNGN: number; mode: string; duration: string; pricingTier: string } | null = null;
  let quoteRequestId = 0;

  function currentDeliveryMethod(): string {
    return (
      document.querySelector<HTMLInputElement>('input[name="deliveryMethod"]:checked')?.value ?? "pickup"
    );
  }

  function updateTotals() {
    const subtotal = cartSubtotalNGN(getCart());
    if (subtotalEl) subtotalEl.textContent = formatNGN(subtotal);

    const isDelivery = currentDeliveryMethod() === "delivery";
    const feeNGN = isDelivery && currentQuote ? currentQuote.feeNGN : 0;
    const total = subtotal + feeNGN;

    if (deliveryFeeRow) deliveryFeeRow.hidden = !(isDelivery && currentQuote);
    if (deliveryFeeAmountEl && currentQuote) deliveryFeeAmountEl.textContent = formatNGN(currentQuote.feeNGN);
    if (summaryTotalRow) summaryTotalRow.hidden = !(isDelivery && currentQuote);
    if (summaryTotalEl) summaryTotalEl.textContent = formatNGN(total);
    if (deliveryFallbackNote) deliveryFallbackNote.hidden = isDelivery && Boolean(currentQuote);

    if (payBtnAmountEl) payBtnAmountEl.textContent = formatNGN(total);
  }

  async function fetchDeliveryQuote() {
    const city = (document.querySelector<HTMLInputElement>('input[name="deliveryCity"]')?.value ?? "").trim();
    const cart = getCart();

    if (!city || cart.length === 0) {
      currentQuote = null;
      updateTotals();
      return;
    }

    const thisRequestId = ++quoteRequestId;
    if (deliveryQuoteStatusEl) {
      deliveryQuoteStatusEl.hidden = false;
      deliveryQuoteStatusEl.textContent = "Calculating delivery fee…";
    }

    try {
      const res = await fetch("/api/delivery-quote", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          city,
          items: cart.map((item) => ({ packSize: item.packSize, quantity: item.quantity })),
        }),
      });
      const data = await res.json();

      // A newer request finished, or the customer already moved on
      // (switched back to pickup) while this was in flight — ignore this
      // stale result rather than overwriting a newer/cleared state with it.
      if (thisRequestId !== quoteRequestId) return;

      if (data.available) {
        currentQuote = {
          feeNGN: data.feeNGN,
          mode: data.mode,
          duration: data.duration,
          pricingTier: data.pricingTier,
        };
        if (deliveryQuoteStatusEl) {
          deliveryQuoteStatusEl.textContent = `Delivery: ${formatNGN(data.feeNGN)} via ${data.mode} (${data.duration})`;
        }
      } else {
        currentQuote = null;
        if (deliveryQuoteStatusEl) {
          deliveryQuoteStatusEl.textContent =
            "Couldn't calculate delivery automatically — we'll confirm your delivery fee after checkout.";
        }
      }
    } catch {
      if (thisRequestId !== quoteRequestId) return;
      currentQuote = null;
      if (deliveryQuoteStatusEl) {
        deliveryQuoteStatusEl.textContent =
          "Couldn't calculate delivery automatically — we'll confirm your delivery fee after checkout.";
      }
    }

    updateTotals();
  }

  // Paystack's inline.js used to be loaded via a single static <script src>
  // tag. That gives it exactly one attempt: if that one request is slow,
  // dropped, or blocked (common on flaky mobile connections — confirmed
  // live, this was happening even in a clean incognito window with no
  // extensions), window.PaystackPop never gets defined for the rest of
  // that page load, no matter how long the customer waits or how many
  // times they click Pay Now. Loading it dynamically lets us actually
  // retry instead of getting one shot at it.
  function loadPaystackScriptOnce(timeoutMs: number): Promise<boolean> {
    return new Promise((resolve) => {
      // @ts-ignore — set once the script below succeeds
      if (typeof window.PaystackPop !== "undefined") {
        resolve(true);
        return;
      }
      const script = document.createElement("script");
      // Cache-busting query param on retries — if the first attempt failed
      // because of a bad cached response (rare, but possible with some
      // network proxies), a byte-identical retry could hit the same cache
      // entry and fail the same way.
      script.src = `https://js.paystack.co/v1/inline.js?_retry=${Date.now()}`;
      const timer = window.setTimeout(() => resolve(false), timeoutMs);
      script.onload = () => {
        window.clearTimeout(timer);
        resolve(true);
      };
      script.onerror = () => {
        window.clearTimeout(timer);
        resolve(false);
      };
      document.head.appendChild(script);
    });
  }

  async function ensurePaystackLoaded(
    { attempts = 2, timeoutMs = 6000 }: { attempts?: number; timeoutMs?: number } = {},
  ): Promise<boolean> {
    for (let i = 0; i < attempts; i++) {
      if (await loadPaystackScriptOnce(timeoutMs)) return true;
    }
    return false;
  }

  // Kick off loading as soon as the cart page is ready — most customers
  // will have a working payment window well before they finish filling in
  // the checkout form, so this first attempt is normally invisible. The
  // submit handler below still checks/retries at click time as a backstop
  // for whoever's connection was still bad at page-load time.
  void ensurePaystackLoaded();

  function formatNGN(amount: number) {
    return `₦${amount.toLocaleString()}`;
  }

  function render() {
    const cart = getCart();
    if (!emptyEl || !filledEl || !itemsEl) return;

    if (cart.length === 0) {
      emptyEl.hidden = false;
      filledEl.hidden = true;
      return;
    }

    emptyEl.hidden = true;
    filledEl.hidden = false;

    itemsEl.innerHTML = cart
      .map(
        (item) => `
      <div class="cart-item" data-slug="${item.productSlug}" data-size="${item.packSize}" data-sku="${item.sku ?? ""}">
        <img src="${item.image ?? ""}" alt="${item.productName}" class="cart-item-photo" />
        <div class="cart-item-info">
          <p class="cart-item-name">${item.productName}</p>
          <p class="cart-item-size">${item.packSize}</p>
          <div class="cart-item-qty">
            <button type="button" class="qty-btn" data-cart-qty-decrease>−</button>
            <span class="qty-value">${item.quantity}</span>
            <button type="button" class="qty-btn" data-cart-qty-increase>+</button>
          </div>
          ${
            item.batchTargetQty
              ? `<p class="cart-item-batch-note" data-batch-note data-slug="${item.productSlug}" data-target="${item.batchTargetQty}">Checking batch progress…</p>`
              : ""
          }
        </div>
        <div class="cart-item-price">
          <span>${formatNGN(item.priceNGN * item.quantity)}</span>
          <button type="button" class="cart-item-remove" data-cart-remove>Remove</button>
        </div>
      </div>
    `,
      )
      .join("");

    updateTotals();
    // Cart contents changed (qty/remove), which can change total weight —
    // re-quote if a delivery city is already entered so the fee stays
    // accurate rather than silently going stale.
    if (currentDeliveryMethod() === "delivery") void fetchDeliveryQuote();

    const batchSummaryNote = document.querySelector<HTMLElement>("[data-batch-summary-note]");
    if (batchSummaryNote) {
      batchSummaryNote.hidden = !cart.some((item) => item.batchTargetQty != null);
    }

    itemsEl.querySelectorAll<HTMLElement>(".cart-item").forEach((row) => {
      const slug = row.dataset.slug ?? "";
      const size = row.dataset.size ?? "";
      const sku = row.dataset.sku || null;
      const item = cart.find((c) => c.productSlug === slug && c.packSize === size && (c.sku || null) === sku);
      if (!item) return;

      row.querySelector("[data-cart-qty-decrease]")?.addEventListener("click", () => {
        updateQuantity(slug, size, sku, item.quantity - 1);
      });
      row.querySelector("[data-cart-qty-increase]")?.addEventListener("click", () => {
        updateQuantity(slug, size, sku, item.quantity + 1);
      });
      row.querySelector("[data-cart-remove]")?.addEventListener("click", () => {
        removeFromCart(slug, size, sku);
      });
    });

    // Fetch live batch progress per unique product — one request per
    // product slug regardless of how many cart lines reference it.
    const batchNoteEls = itemsEl.querySelectorAll<HTMLElement>("[data-batch-note]");
    const seenSlugs = new Set<string>();
    batchNoteEls.forEach(async (noteEl) => {
      const slug = noteEl.dataset.slug ?? "";
      const target = Number(noteEl.dataset.target ?? "0");
      if (!slug || !target || seenSlugs.has(slug)) return;
      seenSlugs.add(slug);

      const matchingNotes = Array.from(batchNoteEls).filter((el) => el.dataset.slug === slug);
      try {
        const res = await fetch(`/api/batch-status?slug=${encodeURIComponent(slug)}`);
        if (!res.ok) throw new Error("batch-status request failed");
        const data = await res.json();
        const collected = Number(data.collectedQuantity ?? 0);
        matchingNotes.forEach((el) => {
          el.textContent = cartMessage(collected, target);
        });
      } catch {
        matchingNotes.forEach((el) => {
          el.textContent = "";
        });
      }
    });
  }

  render();
  window.addEventListener(CART_EVENT_NAME, render);

  // Delivery address field toggling
  const deliveryRadios = document.querySelectorAll<HTMLInputElement>('input[name="deliveryMethod"]');
  const addressField = document.querySelector<HTMLElement>("[data-delivery-address-field]");
  const cityInput = document.querySelector<HTMLInputElement>('input[name="deliveryCity"]');
  deliveryRadios.forEach((radio) => {
    radio.addEventListener("change", () => {
      const isDelivery = radio.value === "delivery" && radio.checked;
      if (addressField) addressField.hidden = !isDelivery;
      if (deliveryLocationRow) deliveryLocationRow.hidden = !isDelivery;
      if (isDelivery && cityInput?.value.trim()) {
        void fetchDeliveryQuote();
      } else {
        currentQuote = null;
        if (deliveryQuoteStatusEl) deliveryQuoteStatusEl.hidden = true;
        updateTotals();
      }
    });
  });

  // Debounced so a quote isn't fired on every keystroke — fires once
  // typing pauses, and again on blur in case the pause detection missed
  // a fast finish (e.g. tabbing straight to the next field).
  let quoteDebounceTimer: number | undefined;
  function scheduleQuote() {
    window.clearTimeout(quoteDebounceTimer);
    quoteDebounceTimer = window.setTimeout(() => void fetchDeliveryQuote(), 600);
  }
  cityInput?.addEventListener("input", scheduleQuote);
  cityInput?.addEventListener("blur", () => void fetchDeliveryQuote());

  // Checkout submit
  const form = document.querySelector<HTMLFormElement>("[data-checkout-form]");
  const errorEl = document.querySelector<HTMLElement>("[data-checkout-error]");
  const payBtn = form?.querySelector<HTMLButtonElement>(".pay-btn") ?? null;
  const payBtnDefaultHTML = payBtn?.innerHTML ?? "";

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (errorEl) errorEl.hidden = true;

    const cart = getCart();
    if (cart.length === 0) return;

    if (!publicKey) {
      if (errorEl) {
        errorEl.textContent =
          "Payment isn't configured yet — the Paystack public key is missing. Please use WhatsApp to order instead.";
        errorEl.hidden = false;
      }
      return;
    }

    // @ts-ignore — set once loadPaystackScriptOnce succeeds
    if (typeof window.PaystackPop === "undefined") {
      // The eager load kicked off on page load hasn't finished (or failed) —
      // give it a real, visible second/third attempt right now rather than
      // immediately giving up. This is what actually fixes the "does
      // nothing / shows the couldn't-load error" report: previously there
      // was only ever the one page-load attempt, with no retry at all.
      if (payBtn) {
        payBtn.disabled = true;
        payBtn.textContent = "Loading secure payment window…";
      }
      const loaded = await ensurePaystackLoaded({ attempts: 2, timeoutMs: 5000 });
      if (payBtn) {
        payBtn.disabled = false;
        payBtn.innerHTML = payBtnDefaultHTML;
      }
      // @ts-ignore
      if (!loaded || typeof window.PaystackPop === "undefined") {
        if (errorEl) {
          errorEl.textContent =
            "We couldn't load the secure payment window just now — this is usually temporary. Please refresh the page and try again, or message us on WhatsApp below to complete your order.";
          errorEl.hidden = false;
        }
        return;
      }
    }

    const data = new FormData(form);
    const name = String(data.get("name") || "");
    const email = String(data.get("email") || "");
    const phone = String(data.get("phone") || "");
    const deliveryMethod = String(data.get("deliveryMethod") || "pickup");
    const deliveryAddress = String(data.get("deliveryAddress") || "");
    const deliveryCity = String(data.get("deliveryCity") || "");
    const deliveryState = String(data.get("deliveryState") || "");

    if (deliveryMethod === "delivery" && (!deliveryAddress.trim() || !deliveryCity.trim() || !deliveryState.trim())) {
      if (errorEl) {
        errorEl.textContent = "Please add your delivery address, city, and state, or switch to in-store pickup.";
        errorEl.hidden = false;
      }
      return;
    }

    const subtotal = cartSubtotalNGN(cart);
    // Only trust currentQuote if it was actually calculated for delivery —
    // never charge a delivery fee for a pickup order even if a stale quote
    // object happens to still be sitting in memory from an earlier toggle.
    const deliveryFeeNGN = deliveryMethod === "delivery" && currentQuote ? currentQuote.feeNGN : 0;
    const total = subtotal + deliveryFeeNGN;
    trackInitiateCheckout(
      total,
      cart.reduce((sum, item) => sum + item.quantity, 0),
    );
    // Short, human-readable reference — doubles as the Paystack transaction
    // reference AND the customer-facing order number (one reference, not
    // two competing IDs to keep in sync).
    const orderRef = `RGF-${Math.random().toString(36).slice(2, 8).toUpperCase()}`;

    const cartMetadata: Pick<CartItem, "productSlug" | "productName" | "packSize" | "sku" | "priceNGN" | "quantity">[] =
      cart.map((item) => ({
        productSlug: item.productSlug,
        productName: item.productName,
        packSize: item.packSize,
        sku: item.sku,
        priceNGN: item.priceNGN,
        quantity: item.quantity,
      }));

    // @ts-ignore — PaystackPop is loaded globally by the inline.js script above
    const handler = window.PaystackPop.setup({
      key: publicKey,
      email,
      amount: Math.round(total * 100), // Paystack expects kobo — includes delivery fee, folded into one charge
      currency: "NGN",
      ref: orderRef,
      metadata: {
        order_ref: orderRef,
        customer_name: name,
        customer_phone: phone,
        delivery_method: deliveryMethod,
        delivery_address: deliveryMethod === "delivery" ? deliveryAddress : null,
        delivery_city: deliveryMethod === "delivery" ? deliveryCity : null,
        delivery_state: deliveryMethod === "delivery" ? deliveryState : null,
        delivery_fee_ngn: deliveryFeeNGN,
        // The exact quote used to charge the customer — order-confirmed.astro
        // books the Topship shipment from THIS, never a fresh re-quote, since
        // Topship requires shipmentCharge to match what was actually quoted
        // and a re-quote could legitimately return a different price.
        topship_quote: deliveryMethod === "delivery" ? currentQuote : null,
        cart: cartMetadata,
        custom_fields: [
          { display_name: "Order Reference", variable_name: "order_ref", value: orderRef },
          { display_name: "Customer Name", variable_name: "customer_name", value: name },
          { display_name: "Phone", variable_name: "phone", value: phone },
        ],
      },
      callback: function (response: { reference: string }) {
        // Payment succeeded — clear the cart before navigating away, then
        // hand off to order-confirmed.astro, which independently re-verifies
        // the payment server-side with Paystack (never trusts this client
        // callback alone) before writing the order to Supabase.
        clearCart();
        const params = new URLSearchParams({ reference: response.reference });
        window.location.href = `/order-confirmed?${params.toString()}`;
      },
      onClose: function () {
        // Customer closed the popup without paying — cart stays intact.
      },
    });
    handler.openIframe();
  });
</script>

<style>
  .cart-page h1 {
    margin-bottom: 1.5rem;
  }

  .cart-empty {
    text-align: center;
    padding: 3rem 0;
  }

  .cart-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 800px) {
    .cart-grid {
      grid-template-columns: 1fr;
    }
  }

  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .cart-item-photo {
    width: 72px;
    height: 72px;
    object-fit: contain;
    background: linear-gradient(160deg, var(--color-cream) 0%, #FBF8F1 100%);
    border-radius: var(--radius);
    padding: 0.4rem;
  }

  .cart-item-name {
    margin: 0;
    font-weight: 600;
    color: var(--color-brown);
  }

  .cart-item-size {
    margin: 0.1rem 0 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .cart-item-batch-note {
    margin: 0.5rem 0 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .batch-summary-note {
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-border);
  }

  .cart-item-qty {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.15rem 0.5rem;
  }

  .qty-btn {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: #fff;
    color: var(--color-plum);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qty-value {
    min-width: 1.2em;
    text-align: center;
    font-weight: 600;
  }

  .cart-item-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-brown);
  }

  .cart-item-remove {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 400;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .cart-summary {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    background: var(--color-cream);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-heading);
