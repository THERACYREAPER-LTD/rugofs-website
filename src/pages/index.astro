---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { siteSettings } from "../data/siteSettings";
import { getLiveProducts } from "../data/products";

const products = getLiveProducts();
---

<BaseLayout title="Home">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="hero-heading">Quality Food, Made Convenient.</h1>
        <p class="hero-intro">
          Tasty, nutritious food products made from carefully processed
          agricultural produce — with quality at the heart of what we do.
        </p>
        <div class="hero-ctas">
          <a href="/products" class="btn btn-primary">Shop Our Products</a>
          <a href="/about" class="btn btn-outline">Our Story</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-visual-inner">
          <img
            src="/images/products/cocoyam-flour-front.webp"
            alt="Rugofs Cocoyam Flour packaging"
            class="hero-photo hero-photo-back"
          />
          <img
            src="/images/products/beans-flour-front.webp"
            alt="Rugofs Beans Flour packaging"
            class="hero-photo hero-photo-front"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Product trust highlights">
    <div class="container trust-strip-inner">
      <div class="trust-badge">
        <span class="trust-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 21c0-8 4-15 14-16-1 10-6 15-14 16z"/>
            <path d="M5 21c2-4 5-7 9-10"/>
          </svg>
        </span>
        <span class="trust-badge-label">100% Natural</span>
      </div>
      <div class="trust-badge">
        <span class="trust-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l7 3v6c0 5-3.2 8-7 9-3.8-1-7-4-7-9V6z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </span>
        <span class="trust-badge-label">No Additives, No Preservatives</span>
      </div>
      <div class="trust-badge">
        <span class="trust-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 8l-9-5-9 5 9 5 9-5z"/>
            <path d="M3 8v8l9 5 9-5V8"/>
            <path d="M12 13v8"/>
          </svg>
        </span>
        <span class="trust-badge-label">Hygienically Processed &amp; Packaged</span>
      </div>
    </div>
  </section>

  <section class="section brand-promise" aria-label="Brand promise">
    <div class="container">
      <p>{siteSettings.brandPromise}</p>
    </div>
  </section>

  <section class="section section--alt story-preview" aria-labelledby="story-heading">
    <div class="container narrow">
      <p class="eyebrow">Our Story</p>
      <h2 id="story-heading">From agricultural potential to everyday nourishment.</h2>
      <p>
        Rugofs Foods grew from a long-standing interest in transforming
        Nigerian agricultural produce into useful, quality food products.
        Over time, that vision expanded beyond spices — the focus became
        clear: take good Nigerian agricultural produce, process it
        carefully, preserve its useful qualities, and make it more
        convenient for families to use.
      </p>
      <p>
        We are building a food brand rooted in Nigerian agriculture,
        practical innovation and a simple belief: better food processing
        can create better value from what our land already produces.
      </p>
      <a href="/about" class="btn btn-outline">Our Story</a>
    </div>
  </section>

  <section class="section" aria-labelledby="products-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The Range</p>
        <h2 id="products-heading">Featured Products</h2>
      </div>
      <div class="grid grid-cards">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-cream) 0%, #fff 100%);
    padding: 5rem 0 4rem;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
  }

  .hero-intro {
    color: var(--color-text-muted);
    font-size: 1.02rem;
    max-width: 52ch;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-visual-inner {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    /* Flat Harvest Plum — no gradient blend, so this reads as the true
       brand color rather than a purple/gold/green wash. Per founder
       feedback: the old radial-gradient treatment was disliked and made
       the palette look off-brand. */
    background: var(--color-plum);
    box-shadow: 0 24px 48px -20px rgba(42, 10, 40, 0.55);
  }

  .hero-photo {
    position: absolute;
    object-fit: contain;
    filter: drop-shadow(0 20px 28px rgba(20, 5, 19, 0.4));
    z-index: 2;
  }

  .hero-photo-back {
    width: 58%;
    top: 8%;
    right: 6%;
    transform: rotate(6deg);
    opacity: 0.92;
  }

  .hero-photo-front {
    width: 64%;
    bottom: 8%;
    left: 6%;
    transform: rotate(-4deg);
    z-index: 3;
  }

  .trust-strip {
    background: var(--color-cream);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1.75rem 0;
  }

  .trust-strip-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 1.5rem 3rem;
  }

  .trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    max-width: 150px;
    text-align: center;
  }

  .trust-badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid var(--color-green);
    color: var(--color-green);
    background: #fff;
  }

  .trust-badge-icon svg {
    width: 24px;
    height: 24px;
  }

  .trust-badge-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--color-brown);
  }

  .brand-promise {
    background: var(--color-plum);
    color: var(--color-cream);
    text-align: center;
  }

  .brand-promise p {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.3rem;
    margin: 0;
  }

  .story-preview .narrow {
    max-width: 640px;
  }

  .story-preview p:not(.eyebrow) {
    color: var(--color-text-muted);
  }

  .story-preview .btn {
    margin-top: 0.5rem;
  }
</style>
