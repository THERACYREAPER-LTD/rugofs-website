---
// Must run server-side — this is where the Supabase service role key is
// used, and where the order lookup (matched on reference + phone) happens.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { whatsappLink } from "../data/siteSettings";
import { getSupabaseServerClient } from "../lib/supabaseServer";
import type { OrderRecord } from "../lib/supabaseServer";
import { orderStatusMessage } from "../lib/batchProgress";

const refParam = (Astro.url.searchParams.get("ref") ?? "").trim();
const phoneParam = (Astro.url.searchParams.get("phone") ?? "").trim();
const hasQuery = refParam.length > 0 && phoneParam.length > 0;

type LookupResult =
  | { state: "idle" }
  | { state: "not-configured" }
  | { state: "not-found" }
  | { state: "found"; order: OrderRecord };

let result: LookupResult = { state: "idle" };

if (hasQuery) {
  const supabase = getSupabaseServerClient();
  if (!supabase) {
    result = { state: "not-configured" };
  } else {
    // Matched on BOTH the order reference and the phone number used at
    // checkout — this is what lets a customer look up their own order
    // without an account/login, while making it impractical for a stranger
    // to guess someone else's order status from the reference alone.
    const { data, error } = await supabase
      .from("orders")
      .select("*")
      .eq("order_ref", refParam.toUpperCase())
      .eq("customer_phone", phoneParam)
      .maybeSingle();

    if (error || !data) {
      result = { state: "not-found" };
    } else {
      result = { state: "found", order: data as OrderRecord };
    }
  }
}

const STATUS_LABELS: Record<string, string> = {
  paid: "Payment Received",
  packed: "Packed",
  out_for_delivery: "Out for Delivery",
  delivered: "Delivered",
  cancelled: "Cancelled",
};

const whatsappHelp = whatsappLink("Hi Rugofs Foods, I'm trying to check on an order but can't find it.");
---

<BaseLayout title="Order Status" description="Check the status of your Rugofs Foods order." noindex>
  <section class="section">
    <div class="container status-page">
      <h1>Check Your Order</h1>
      <p class="status-intro">
        Enter your order reference and the phone number you used at checkout — no account needed.
      </p>

      <form method="GET" class="status-form">
        <label>
          Order Reference
          <input type="text" name="ref" placeholder="RGF-XXXXXX" value={refParam} required />
        </label>
        <label>
          Phone Number
          <input type="tel" name="phone" value={phoneParam} required />
        </label>
        <button type="submit" class="btn btn-primary">Check Status</button>
      </form>

      {result.state === "found" && (
        <div class="status-result">
          <p class="status-badge">{STATUS_LABELS[result.order.status] ?? result.order.status}</p>
          <ul class="order-items">
            {result.order.items.map((item) => (
              <li>
                <div class="order-item-row">
                  <span>{item.productName} ({item.packSize}) × {item.quantity}</span>
                  <span>₦{(item.priceNGN * item.quantity).toLocaleString()}</span>
                </div>
                {item.batch && (
                  <p class="batch-note">
                    {orderStatusMessage(
                      item.batch.collectedQuantity,
                      item.batch.targetQuantity,
                      item.batch.status === "in_production" || item.batch.status === "fulfilled",
                    )}
                  </p>
                )}
              </li>
            ))}
          </ul>
          <p class="status-total">Total: ₦{result.order.subtotal_ngn.toLocaleString()}</p>
          <p class="status-delivery">
            {result.order.delivery_method === "delivery"
              ? `Delivery to: ${result.order.delivery_address}`
              : "In-store pickup"}
          </p>
          <p class="status-date">
            Ordered {new Date(result.order.created_at).toLocaleDateString("en-NG", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </p>
        </div>
      )}

      {result.state === "not-found" && (
        <div class="open-note">
          We couldn't find an order matching that reference and phone number. Double-check both,
          or{" "}
          <a href={whatsappHelp} target="_blank" rel="noopener noreferrer">message us on WhatsApp</a>{" "}
          and we'll look it up directly.
        </div>
      )}

      {result.state === "not-configured" && (
        <div class="open-note">
          Order lookup isn't available on this deployment right now — please{" "}
          <a href={whatsappHelp} target="_blank" rel="noopener noreferrer">message us on WhatsApp</a>{" "}
          with your order reference instead.
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .status-page {
    max-width: 560px;
  }

  .status-intro {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .status-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .status-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-brown);
  }

  .status-form input {
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: 0.65em 0.8em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-weight: 400;
    color: var(--color-text);
  }

  .status-result {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    background: var(--color-cream);
  }

  .status-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-plum);
    background: #fff;
    border: 1px solid var(--color-plum);
    border-radius: 999px;
    padding: 0.3em 1em;
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }

  .order-items {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .order-items li {
    padding: 0.4rem 0;
    font-size: 0.9rem;
    color: var(--color-brown);
  }

  .order-item-row {
    display: flex;
    justify-content: space-between;
  }

  .batch-note {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .status-total {
    font-weight: 700;
    font-family: var(--font-heading);
    color: var(--color-plum);
  }

  .status-delivery,
  .status-date {
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }
</style>
