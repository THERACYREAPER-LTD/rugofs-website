---
export const prerender = false; // must run server-side — this is where the Paystack secret key and Supabase service key are used

import BaseLayout from "../layouts/BaseLayout.astro";
import { whatsappLink } from "../data/siteSettings";
import { getSupabaseServerClient } from "../lib/supabaseServer";
import type { OrderItem, BatchInfo } from "../lib/supabaseServer";
// NOTE: products.ts fetches from Sanity via a top-level await, written with
// build-time prerendered pages in mind. Importing it here (a prerender=false
// server route) means that fetch re-runs on every request/cold start rather
// than once at build time — an acceptable trade-off for a low-traffic site
// to avoid a second Sanity query helper, but worth knowing if traffic grows
// enough that this becomes a real cost/latency concern.
import { getProductBySlug } from "../data/products";
import { orderConfirmedMessage } from "../lib/batchProgress";

// SECURITY: PAYSTACK_SECRET_KEY has no PUBLIC_ prefix, so Astro keeps it
// server-only — it is never included in any client-side JS bundle. This
// code only runs on Netlify's server at request time.
const secretKey = import.meta.env.PAYSTACK_SECRET_KEY;

const reference = Astro.url.searchParams.get("reference");

type CartMetadata = {
  order_ref?: string;
  customer_name?: string;
  customer_phone?: string;
  delivery_method?: "pickup" | "delivery";
  delivery_address?: string | null;
  cart?: OrderItem[];
};

type VerifyResult =
  | { state: "no-reference" }
  | { state: "not-configured" }
  | { state: "error"; message: string }
  | { state: "failed"; message: string }
  | {
      state: "success";
      amountNGN: number;
      paidAt: string;
      customerEmail: string;
      metadata: CartMetadata;
    };

async function verify(ref: string, key: string): Promise<VerifyResult> {
  try {
    // Paystack transaction verify endpoint. Confirm the exact path/response
    // shape against Paystack's current API docs before go-live — this is
    // built from the commonly documented shape, not guaranteed unchanged.
    const res = await fetch(`https://api.paystack.co/transaction/verify/${encodeURIComponent(ref)}`, {
      headers: { Authorization: `Bearer ${key}` },
    });
    const json = await res.json();

    if (!res.ok || !json?.status) {
      return { state: "error", message: json?.message ?? "Could not verify this transaction." };
    }

    const data = json.data;
    if (data?.status !== "success") {
      return { state: "failed", message: data?.gateway_response ?? "Payment was not successful." };
    }

    return {
      state: "success",
      amountNGN: (data.amount ?? 0) / 100,
      paidAt: data.paid_at ?? "",
      customerEmail: data.customer?.email ?? "",
      // The cart contents, customer/delivery info, and order_ref were set
      // as Paystack metadata at checkout time (see cart.astro) — Paystack
      // stores and returns them here. This is the ONLY place order details
      // are reconstructed server-side; the client's cart is never trusted
      // directly for what gets charged or recorded.
      metadata: (data.metadata ?? {}) as CartMetadata,
    };
  } catch (err) {
    return { state: "error", message: "Could not reach Paystack to verify this payment." };
  }
}

let result: VerifyResult;
if (!secretKey) {
  result = { state: "not-configured" };
} else if (!reference) {
  result = { state: "no-reference" };
} else {
  result = await verify(reference, secretKey);
}

let orderWriteError = false;
let orderRef: string | null = null;
let confirmedItems: OrderItem[] = [];

if (result.state === "success") {
  const meta = result.metadata ?? {};
  orderRef = meta.order_ref ?? reference ?? null;
  const supabase = getSupabaseServerClient();

  if (supabase && orderRef && meta.cart && meta.cart.length > 0) {
    // Check whether this order was already written before doing anything
    // batch-related. If the customer refreshes this page, Paystack verify()
    // runs again (harmless, idempotent) — but assign_order_to_batch()
    // increments a running count, so calling it a second time for the same
    // order would silently double-count that order's quantity against its
    // batch. Only run batch assignment the FIRST time this order_ref is
    // seen; on a refresh, just read back what was already recorded.
    const { data: existingOrder } = await supabase
      .from("orders")
      .select("items")
      .eq("order_ref", orderRef)
      .maybeSingle();

    if (existingOrder) {
      confirmedItems = (existingOrder.items as OrderItem[]) ?? meta.cart;
    } else {
      // Group cart lines by product (a customer could in principle have
      // more than one pack size of the same product, though today there's
      // only one approved pack size per product) so each product is only
      // assigned to its batch ONCE per order, with its total quantity —
      // not once per cart line.
      const qtyByProductSlug = new Map<string, number>();
      for (const item of meta.cart) {
        qtyByProductSlug.set(item.productSlug, (qtyByProductSlug.get(item.productSlug) ?? 0) + item.quantity);
      }

      const batchByProductSlug = new Map<string, BatchInfo>();
      for (const [productSlug, quantity] of qtyByProductSlug.entries()) {
        const product = getProductBySlug(productSlug);
        if (!product || product.batchTargetQty == null) continue; // batching not configured for this product

        const { data: batchRow, error: batchError } = await supabase
          .rpc("assign_order_to_batch", {
            p_product_slug: productSlug,
            p_product_name: product.name,
            p_quantity: quantity,
            p_target_quantity: product.batchTargetQty,
          })
          .single();

        if (batchError || !batchRow) {
          // Don't block the order over batch tracking failing — the order
          // itself (payment + fulfillment) is what matters most. Log for
          // follow-up; the item just won't show batch progress.
          console.error(`[batches] Failed to assign ${productSlug} to a batch:`, batchError?.message);
          continue;
        }

        batchByProductSlug.set(productSlug, {
          batchId: (batchRow as any).batch_id,
          status: (batchRow as any).batch_status,
          collectedQuantity: (batchRow as any).collected_quantity,
          targetQuantity: (batchRow as any).target_quantity,
        });
      }

      confirmedItems = (meta.cart as OrderItem[]).map((item) => ({
        ...item,
        batch: batchByProductSlug.get(item.productSlug) ?? null,
      }));

      // Upsert on order_ref: belt-and-braces against a race between two
      // near-simultaneous requests for the same reference (e.g. a
      // double-click before redirect). The batch-assignment guard above
      // (checked via a SELECT, not a DB-level lock) is the primary
      // protection; this keeps the order row itself idempotent regardless.
      const { error } = await supabase.from("orders").upsert(
        {
          order_ref: orderRef,
          customer_name: meta.customer_name ?? "",
          customer_phone: meta.customer_phone ?? "",
          customer_email: result.customerEmail ?? "",
          delivery_method: meta.delivery_method ?? "pickup",
          delivery_address: meta.delivery_address ?? null,
          items: confirmedItems,
          subtotal_ngn: result.amountNGN,
          status: "paid",
          paystack_paid_at: result.paidAt || null,
        },
        { onConflict: "order_ref" },
      );
      if (error) {
        // Payment already succeeded — don't block the customer's confirmation
        // over a database write failing. Flag it so the page can still tell
        // them to keep their WhatsApp fallback handy, and so this is visible
        // in Netlify's function logs for follow-up.
        console.error("[supabase] Failed to write order record:", error.message);
        orderWriteError = true;
      }
    }
  } else if (!supabase) {
    console.error(
      "[supabase] Order verified but not recorded — PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY not configured.",
    );
    orderWriteError = true;
    confirmedItems = meta.cart ?? [];
  } else {
    confirmedItems = meta.cart ?? [];
  }
}

const cartItems: OrderItem[] = confirmedItems;
const deliveryMethod = result.state === "success" ? (result.metadata.delivery_method ?? "pickup") : "pickup";
const deliveryAddress = result.state === "success" ? (result.metadata.delivery_address ?? "") : "";

const orderSummaryLines = cartItems
  .map((item) => `- ${item.productName} (${item.packSize}) x${item.quantity}`)
  .join("\n");

const notifyWhatsapp = whatsappLink(
  `Hi Rugofs Foods, I just paid for my order. Reference: ${orderRef ?? reference ?? ""}${
    orderSummaryLines ? `\n${orderSummaryLines}` : ""
  }`,
);
---

<BaseLayout title="Order Confirmation">
  <section class="section">
    <div class="container confirm-box">
      {result.state === "success" && (
        <>
          <h1>Payment Confirmed</h1>
          <p>
            Thank you — your payment of <strong>₦{result.amountNGN.toLocaleString()}</strong> was
            verified successfully.
          </p>
          {orderRef && <p class="ref-line">Order Reference: <code>{orderRef}</code></p>}

          {cartItems.length > 0 && (
            <ul class="order-items">
              {cartItems.map((item) => (
                <li>
                  <div class="order-item-row">
                    <span>{item.productName} ({item.packSize}) × {item.quantity}</span>
                    <span>₦{(item.priceNGN * item.quantity).toLocaleString()}</span>
                  </div>
                  {item.batch && (
                    <p class="batch-note">
                      {orderConfirmedMessage(
                        item.batch.collectedQuantity,
                        item.batch.targetQuantity,
                        item.batch.status === "in_production",
                      )}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          )}

          <p class="delivery-line">
            {deliveryMethod === "delivery"
              ? `Delivery to: ${deliveryAddress || "address provided at checkout"}`
              : "In-store pickup"}
          </p>

          <div class="open-note">
            {cartItems.some((item) => item.batch)
              ? "Your order is confirmed and pooled into its production batch — see the batch progress above. "
              : deliveryMethod === "delivery"
              ? "We'll confirm your delivery fee and timing on WhatsApp shortly. "
              : "We'll confirm pickup details with you on WhatsApp shortly. "}
            {orderRef && (
              <>
                You can check your order status any time at{" "}
                <a href={`/order-status?ref=${encodeURIComponent(orderRef)}`}>rugofsfoods.com/order-status</a>{" "}
                using this reference and your phone number.
              </>
            )}
          </div>

          {orderWriteError && (
            <div class="open-note warn-note">
              Your payment was successful, but we had trouble saving your order details on our
              end — please message us on WhatsApp with your reference below just in case, so we
              can confirm it manually.
            </div>
          )}

          <a href={notifyWhatsapp} class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">
            Send Order Details on WhatsApp
          </a>
        </>
      )}

      {result.state === "failed" && (
        <>
          <h1>Payment Not Completed</h1>
          <p>{result.message}</p>
          <a href="/products" class="btn btn-outline">Back to Shop</a>
        </>
      )}

      {(result.state === "error" || result.state === "no-reference" || result.state === "not-configured") && (
        <>
          <h1>We Couldn't Confirm This Payment</h1>
          <p>
            {result.state === "not-configured"
              ? "Payment verification isn't configured on this deployment yet (missing Paystack secret key)."
              : result.state === "no-reference"
              ? "No payment reference was provided."
              : result.message}
          </p>
          <p>
            If you did complete a payment, please don't worry — message us on
            WhatsApp with your payment reference and we'll confirm it manually.
          </p>
          <a href={notifyWhatsapp} class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">
            Message Us on WhatsApp
          </a>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .confirm-box {
    max-width: 640px;
    text-align: left;
    padding: 2rem 0;
  }

  .confirm-box h1 {
    text-align: center;
  }

  .confirm-box > p:first-of-type {
    text-align: center;
  }

  .ref-line {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .order-items {
    list-style: none;
    margin: 1.25rem 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .order-items li {
    padding: 0.6rem 0;
    font-size: 0.92rem;
    color: var(--color-brown);
  }

  .order-item-row {
    display: flex;
    justify-content: space-between;
  }

  .order-items li + li {
    border-top: 1px solid var(--color-border);
  }

  .batch-note {
    margin: 0.35rem 0 0;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .delivery-line {
    font-weight: 600;
    color: var(--color-plum);
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }

  .confirm-box .open-note {
    text-align: left;
    margin: 1.5rem 0;
  }

  .warn-note {
    border-color: #A33A3A;
    color: #A33A3A;
  }

  .confirm-box .btn-whatsapp {
    display: block;
    text-align: center;
  }
</style>
