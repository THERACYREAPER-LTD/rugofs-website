---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products, getProductBySlug } from "../../data/products";
import type { PackSize } from "../../data/products";
import { whatsappLink } from "../../data/siteSettings";

export function getStaticPaths() {
  return products
    .filter((p) => p.status === "live")
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug as string);

if (!product) {
  return Astro.redirect("/products");
}

const approvedSizes = product.packSizes.filter((p: PackSize) => p.nafdacApproved);
---

<BaseLayout title={product.name} description={product.shortDescription}>
  <section class="section">
    <div class="container product-detail">
      <div>
        {product.images.length > 0 ? (
          <img src={product.images[0]} alt={product.name} class="detail-photo" />
        ) : (
          <div class="placeholder-photo detail-photo">Product photo coming soon</div>
        )}
      </div>

      <div>
        {product.isBestseller && <span class="badge">Best Seller</span>}
        <h1>{product.name}</h1>
        <p class="detail-desc">{product.longDescription}</p>

        <dl class="spec-list">
          <div>
            <dt>Active ingredient</dt>
            <dd>{product.activeIngredient}</dd>
          </div>
          <div>
            <dt>NAFDAC registration</dt>
            <dd>{product.nafdacRegNo}</dd>
          </div>
          <div>
            <dt>Available pack size</dt>
            <dd>{approvedSizes.map((s) => s.size).join(", ")}</dd>
          </div>
        </dl>

        <div class="price-block">
          {approvedSizes.map((size) => (
            <div class="price-row">
              <span class="price-size">{size.size}</span>
              <span class="price-value">
                {size.priceNGN != null
                  ? `₦${size.priceNGN.toLocaleString()}`
                  : "Message us on WhatsApp for current pricing"}
              </span>
            </div>
          ))}
        </div>

        {/* Add to Cart only shows once a real price is set on this pack size
            in Sanity. Until then, pricing isn't finalized, so customers get
            a WhatsApp CTA instead — no placeholder charge is ever shown to
            a real visitor. Only one NAFDAC-approved pack size exists per
            product today, so this checks out against approvedSizes[0]
            directly. If a second approved size is ever added, this needs a
            size selector before add-to-cart instead of assuming the first
            one. */}
        {approvedSizes[0] && approvedSizes[0].priceNGN != null ? (
          <div
            class="add-to-cart-block"
            data-product-slug={product.slug}
            data-product-name={product.name}
            data-pack-size={approvedSizes[0].size}
            data-sku={approvedSizes[0].sku ?? ""}
            data-price-ngn={approvedSizes[0].priceNGN}
            data-image={product.images[0] ?? ""}
          >
            <div class="qty-row">
              <span class="qty-label">Quantity</span>
              <div class="qty-control">
                <button type="button" class="qty-btn" data-qty-decrease aria-label="Decrease quantity">−</button>
                <span class="qty-value" data-qty-value>1</span>
                <button type="button" class="qty-btn" data-qty-increase aria-label="Increase quantity">+</button>
              </div>
            </div>
            <button type="button" class="btn btn-primary order-btn" data-add-to-cart>
              Add to Cart
            </button>
            <p class="cart-added-note" data-cart-added hidden>Added to your cart.</p>
          </div>
        ) : (
          approvedSizes[0] && (
            <a
              href={whatsappLink(`Hi Rugofs Foods, I'd like to order ${product.name} (${approvedSizes[0].size}).`)}
              class="btn btn-whatsapp-outline order-btn"
              target="_blank"
              rel="noopener noreferrer"
            >
              Message on WhatsApp to Order
            </a>
          )
        )}

        {(!product.preparationGuide || !product.nutritionInfo) && (
          <div class="open-note" style="margin-top: 1.5rem;">
            Nutrition information and preparation guidance for this product
            are coming soon.
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { addToCart } from "../../lib/cart";

  document.querySelectorAll<HTMLElement>(".add-to-cart-block").forEach((block) => {
    const qtyValueEl = block.querySelector<HTMLElement>("[data-qty-value]");
    const decreaseBtn = block.querySelector<HTMLButtonElement>("[data-qty-decrease]");
    const increaseBtn = block.querySelector<HTMLButtonElement>("[data-qty-increase]");
    const addBtn = block.querySelector<HTMLButtonElement>("[data-add-to-cart]");
    const addedNote = block.querySelector<HTMLElement>("[data-cart-added]");

    let qty = 1;
    const renderQty = () => {
      if (qtyValueEl) qtyValueEl.textContent = String(qty);
    };

    decreaseBtn?.addEventListener("click", () => {
      qty = Math.max(1, qty - 1);
      renderQty();
    });
    increaseBtn?.addEventListener("click", () => {
      qty = Math.min(20, qty + 1);
      renderQty();
    });

    addBtn?.addEventListener("click", () => {
      addToCart(
        {
          productSlug: block.dataset.productSlug ?? "",
          productName: block.dataset.productName ?? "",
          packSize: block.dataset.packSize ?? "",
          sku: block.dataset.sku || null,
          priceNGN: Number(block.dataset.priceNgn ?? "0"),
          image: block.dataset.image || null,
        },
        qty,
      );
      if (addedNote) {
        addedNote.hidden = false;
        window.setTimeout(() => {
          addedNote.hidden = true;
        }, 2500);
      }
      qty = 1;
      renderQty();
    });
  });
</script>

<style>
  .product-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 720px) {
    .product-detail {
      grid-template-columns: 1fr;
    }
  }

  .detail-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: contain;
    padding: 2rem;
    background: linear-gradient(160deg, var(--color-cream) 0%, #FBF8F1 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    filter: drop-shadow(0 12px 18px rgba(43, 35, 32, 0.12));
  }

  .detail-desc {
    color: var(--color-text-muted);
    font-size: 1.02rem;
  }

  .spec-list {
    margin: 1.5rem 0;
    display: grid;
    gap: 0.75rem;
  }

  .spec-list dt {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .spec-list dd {
    margin: 0;
    font-weight: 600;
    color: var(--color-brown);
  }

  .price-block {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
    margin-bottom: 1.5rem;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .price-size {
    color: var(--color-plum);
  }

  .price-value {
    color: var(--color-brown);
    font-size: 0.95rem;
  }

  .order-btn {
    width: 100%;
    text-align: center;
  }

  .add-to-cart-block {
    margin-bottom: 1rem;
  }

  .qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .qty-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-brown);
  }

  .qty-control {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.3rem 0.6rem;
  }

  .qty-btn {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: #fff;
    color: var(--color-plum);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qty-btn:hover {
    border-color: var(--color-plum);
  }

  .qty-value {
    min-width: 1.5em;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .cart-added-note {
    color: var(--color-green);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    margin: 0.6rem 0 0;
  }
</style>
